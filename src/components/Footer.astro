---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand-col">
      <div class="footer-brand">
        <span class="brand-word">shae</span>
        <span class="brand-dot">.</span>
        <span class="version-badge">v0.6.0</span>
      </div>
      <p class="footer-tagline">
        A systems programming language with a stack VM, Cranelift JIT, LLVM SSA backend, zero-copy
        buffers, and an actor cluster mesh. One binary. No ceremony.
      </p>
      <div class="footer-specs">
        <span>Rust 2024 Engine</span>
        <span class="sep">/</span>
        <span>Chunks 1–34</span>
        <span class="sep">/</span>
        <span>MIT License</span>
      </div>
    </div>

    <div class="footer-grid">
      <div class="footer-col">
        <h3 class="col-title">
          <span class="col-index">01</span> Navigation
        </h3>
        <ul class="col-list">
          <li>
            <a href="/">Overview</a>
          </li>
          <li>
            <a href="/docs">Documentation</a>
          </li>
          <li>
            <a href="/features">Features &amp; Architecture</a>
          </li>
          <li>
            <a href="/benchmarks">Benchmarks &amp; Roadmap</a>
          </li>
          <li>
            <a href="/download">Download &amp; Install</a>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="col-title">
          <span class="col-index">02</span> Publication
        </h3>
        <ul class="col-list">
          <li>
            <a href="/shae_the_complete_guide.pdf" target="_blank" rel="noopener">
              42-Page Complete Guide (PDF)
            </a>
          </li>
          <li>
            <a href="/docs#stdlib-reference">Standard Library Reference</a>
          </li>
          <li>
            <a href="/features#llvm-ssa">LLVM SSA Backend</a>
          </li>
          <li>
            <a href="/features#cluster-mesh">TLS/mTLS Cluster Mesh</a>
          </li>
          <li>
            <a href="/install.sh">Universal Install Script</a>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="col-title">
          <span class="col-index">03</span> Ecosystem
        </h3>
        <ul class="col-list">
          <li>
            <a href="https://github.com/spdedsec/shae" target="_blank" rel="noopener noreferrer">
              GitHub Repository <span class="ext">↗</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/spdedsec/shae/releases"
              target="_blank"
              rel="noopener noreferrer"
            >
              Release Notes (v0.6.0) <span class="ext">↗</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/spdedsec/shae/issues"
              target="_blank"
              rel="noopener noreferrer"
            >
              Issue Tracker <span class="ext">↗</span>
            </a>
          </li>
          <li>
            <a href="/download#vscode">VS Code Extension</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-inner">
      <div class="colophon">
        <span>&copy; {year} Shae Project Contributors. Distributed under the MIT License.</span>
        <span class="typeset-note">
          Typeset in Archivo, Instrument Sans &amp; JetBrains Mono. Built with Astro.
        </span>
      </div>
      <div class="status-indicator">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span class="status-text">v0.6.0 // 320+ Tests Green</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-color);
    padding-top: 3.5rem;
    position: relative;
    z-index: 2;
    font-family: var(--font-sans);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 4rem;
    padding-bottom: 3.5rem;
    flex-wrap: wrap;
  }

  .footer-brand-col {
    max-width: 360px;
  }

  .footer-brand {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .brand-word {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--text-main);
  }

  .brand-dot {
    color: var(--accent-primary);
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
  }

  .version-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    background: transparent;
    color: var(--accent-primary);
    border: 1px solid var(--accent-badge-border);
    padding: 0.18rem 0.4rem;
    border-radius: 0;
    font-weight: 500;
    letter-spacing: 0.06em;
    margin-left: 0.5rem;
  }

  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 1.35rem;
    max-width: 34ch;
  }

  .footer-specs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .sep {
    color: var(--accent-primary);
    opacity: 1;
  }

  .footer-grid {
    display: flex;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .footer-col {
    min-width: 160px;
  }

  .col-title {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-main);
    margin-bottom: 1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--border-color);
  }

  .col-index {
    color: var(--accent-primary);
    font-size: 0.6rem;
  }

  .col-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .col-list li {
    margin-bottom: 0.55rem;
  }

  .col-list a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.88rem;
    transition: color var(--dur-fast) ease;
    display: inline-block;
  }

  .col-list a:hover {
    color: var(--accent-primary);
    transform: none;
  }

  .ext {
    font-family: var(--font-mono);
    font-size: 0.68em;
    opacity: 0.6;
  }

  .footer-bottom {
    border-top: 1px solid var(--border-color);
    padding: 1.15rem 0;
    background: transparent;
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .colophon {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .typeset-note {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-green);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 0;
    background: var(--accent-green);
    box-shadow: none;
    animation: status-pulse 2.4s steps(2, end) infinite;
  }

  @keyframes status-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  @media (max-width: 760px) {
    .footer-inner {
      gap: 2.5rem;
      flex-direction: column;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
      width: 100%;
    }
    .footer-col {
      min-width: 0;
    }
  }

  @media (max-width: 460px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

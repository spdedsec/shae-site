---
const year = new Date().getFullYear();
---

<footer class="site-footer" transition:name="main-footer" transition:persist>
  <div class="container footer-inner">
    <!-- Brand & Summary Column -->
    <div class="footer-brand-col">
      <div class="footer-brand">
        <span class="brand-serif">shae</span>
        <span class="brand-dot">.</span>
        <span class="version-badge">v0.4.0</span>
      </div>
      <p class="footer-tagline">
        An editorial-grade systems programming language with Cranelift JIT, LLVM SSA backend, 
        zero-copy buffers, and actor cluster mesh.
      </p>
      <div class="footer-specs">
        <span>Rust 2024 Engine</span>
        <span class="sep">•</span>
        <span>Chunks 1–31</span>
        <span class="sep">•</span>
        <span>MIT License</span>
      </div>
    </div>

    <!-- Multi-Column Links -->
    <div class="footer-grid">
      <!-- Col 1: Canonical Navigation -->
      <div class="footer-col">
        <h4 class="col-title">Navigation</h4>
        <ul class="col-list">
          <li><a href="/">Overview</a></li>
          <li><a href="/docs">Documentation</a></li>
          <li><a href="/features">Features &amp; Architecture</a></li>
          <li><a href="/benchmarks">Benchmarks &amp; Roadmap</a></li>
          <li><a href="/download">Download &amp; Install</a></li>
        </ul>
      </div>

      <!-- Col 2: Publication & Documentation -->
      <div class="footer-col">
        <h4 class="col-title">Publication</h4>
        <ul class="col-list">
          <li>
            <a href="/shae_the_complete_guide.pdf" target="_blank" rel="noopener">
              42-Page Complete Guide (PDF)
            </a>
          </li>
          <li><a href="/docs#stdlib-reference">Standard Library Reference</a></li>
          <li><a href="/features#llvm-ssa">LLVM SSA Backend</a></li>
          <li><a href="/features#cluster-mesh">TLS/mTLS Cluster Mesh</a></li>
          <li><a href="/install.sh">Universal Install Script</a></li>
        </ul>
      </div>

      <!-- Col 3: Ecosystem & Repository -->
      <div class="footer-col">
        <h4 class="col-title">Ecosystem</h4>
        <ul class="col-list">
          <li>
            <a href="https://github.com/spdedsec/shae" target="_blank" rel="noopener noreferrer">
              GitHub Repository
            </a>
          </li>
          <li>
            <a href="https://github.com/spdedsec/shae/releases" target="_blank" rel="noopener noreferrer">
              Release Notes (v0.4.0)
            </a>
          </li>
          <li>
            <a href="https://github.com/spdedsec/shae/issues" target="_blank" rel="noopener noreferrer">
              Issue Tracker
            </a>
          </li>
          <li><a href="/download#vscode">VS Code Extension</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Colophon Bar -->
  <div class="footer-bottom">
    <div class="container bottom-inner">
      <div class="colophon">
        <span>&copy; {year} Shae Project Contributors. Distributed under the MIT License.</span>
        <span class="typeset-note">Typeset in Times New Roman. Built with Astro.</span>
      </div>
      <div class="status-indicator">
        <span class="pulse-dot"></span>
        <span class="status-text">v0.4.0 Release // 27/27 Tests Green</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--bg-surface, #ffffff);
    border-top: 1px solid var(--border-color, rgba(0, 0, 0, 0.08));
    padding-top: 3.5rem;
    position: relative;
    z-index: 2;
    font-family: 'Times New Roman', Times, 'Nimbus Roman No9 L', serif;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 3.5rem;
    padding-bottom: 3rem;
    flex-wrap: wrap;
  }

  .footer-brand-col {
    max-width: 380px;
  }

  .footer-brand {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-bottom: 0.85rem;
  }

  .brand-serif {
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-main, #111111);
  }

  .brand-dot {
    color: var(--accent-primary, #8b0000);
    font-weight: 700;
    font-size: 1.55rem;
  }

  .version-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    background: var(--accent-badge-bg, rgba(139, 0, 0, 0.08));
    color: var(--accent-primary, #8b0000);
    border: 1px solid var(--accent-badge-border, rgba(139, 0, 0, 0.25));
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
    margin-left: 0.4rem;
  }

  .footer-tagline {
    color: var(--text-muted, #555555);
    font-size: 0.94rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .footer-specs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.76rem;
    color: var(--text-muted, #777777);
  }

  .sep {
    opacity: 0.5;
  }

  .footer-grid {
    display: flex;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .footer-col {
    min-width: 140px;
  }

  .col-title {
    font-family: 'Times New Roman', Times, serif;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-main, #111111);
    margin-bottom: 1rem;
  }

  .col-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .col-list li {
    margin-bottom: 0.6rem;
  }

  .col-list a {
    color: var(--text-muted, #555555);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-block;
  }

  .col-list a:hover {
    color: var(--accent-primary, #8b0000);
    transform: translateX(2px);
  }

  .footer-bottom {
    border-top: 1px solid var(--border-color, rgba(0, 0, 0, 0.08));
    padding: 1.25rem 0;
    background: var(--bg-surface, #ffffff);
    font-size: 0.82rem;
    color: var(--text-muted, #666666);
  }

  .bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .colophon {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .typeset-note {
    font-style: italic;
    opacity: 0.8;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #16a34a;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 8px rgba(22, 163, 74, 0.6);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
</style>

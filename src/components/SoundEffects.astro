---
// Audio synthesizer for tactile retro mechanical clicks
---
<script>
  let audioCtx: AudioContext | null = null;
  let isMuted = false;

  function initAudio() {
    if (!audioCtx && typeof window !== 'undefined') {
      const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AudioContextClass) {
        audioCtx = new AudioContextClass();
      }
    }
  }

  function playClick(pitch = 800, duration = 0.015) {
    if (isMuted) return;
    try {
      initAudio();
      if (!audioCtx) return;
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc.type = 'triangle';
      osc.frequency.setValueAtTime(pitch, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(120, audioCtx.currentTime + duration);

      gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    } catch {
      // Audio autoplay policy fallback
    }
  }

  function attachSoundListeners() {
    document.querySelectorAll<HTMLElement>('a, button, .interactive-click').forEach((el) => {
      if (el.dataset.soundAttached) return;
      el.dataset.soundAttached = 'true';
      el.addEventListener('mouseenter', () => playClick(1200, 0.008));
      el.addEventListener('click', () => playClick(600, 0.02));
    });
  }

  // Handle initial load and view transitions
  document.addEventListener('astro:page-load', () => {
    attachSoundListeners();
  });

  // Global sound mute toggle
  window.addEventListener('toggle-audio', () => {
    isMuted = !isMuted;
    localStorage.setItem('shae-audio-muted', isMuted ? 'true' : 'false');
  });

  if (typeof localStorage !== 'undefined') {
    isMuted = localStorage.getItem('shae-audio-muted') === 'true';
  }
</script>

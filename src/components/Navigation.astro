---
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Overview', href: '/' },
  { label: 'Docs', href: '/docs' },
  { label: 'Features', href: '/features' },
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Download', href: '/download' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <div class="logo-area">
      <a href="/" class="brand-link" aria-label="Shae Home">
        <span class="logo-word">shae</span><span class="logo-period">.</span>
      </a>
      <span class="brand-badge">v0.6.0</span>
    </div>

    <nav class="nav-links" aria-label="Main Navigation">
      {navItems.map((item) => {
        const itemHrefClean = item.href.replace(/\/$/, '') || '/';
        const isActive = itemHrefClean === '/'
          ? cleanPath === '/'
          : cleanPath === itemHrefClean || cleanPath.startsWith(itemHrefClean + '/');
        return (
          <a
            href={item.href}
            class:list={['nav-item', { active: isActive }]}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <label class="theme-select-wrapper">
        <span class="util-label">Theme</span>
        <select id="theme-switcher" class="theme-select" aria-label="Theme selector" title="Select theme">
          <option value="light">Light</option>
          <option value="dark">Dark</option>
          <option value="vantablack">Vantablack</option>
        </select>
      </label>

      <button
        id="toggle-audio-btn"
        class="util-btn"
        type="button"
        title="Toggle interface audio"
        aria-label="Sound"
        aria-pressed="true"
      >
        <span class="audio-mark" aria-hidden="true"></span>
        <span class="util-label">Sound</span>
      </button>

      <a
        href="https://github.com/spdedsec/shae"
        target="_blank"
        rel="noopener noreferrer"
        class="github-btn"
        aria-label="Shae GitHub repository"
      >
        <span>GitHub</span>
        <span class="v-tag" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-border);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  /* One functional material layer: content scrolls beneath the toolbar. */
  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      background: color-mix(in srgb, var(--header-bg) 84%, transparent);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
    }
  }

  .header-inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    min-height: 68px;
    gap: 2rem;
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex: none;
  }

  .brand-link {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.42rem;
    font-weight: 700;
    letter-spacing: -0.055em;
    color: var(--text-main);
    line-height: 1;
  }

  .brand-link:hover {
    color: var(--text-main);
  }

  .logo-period {
    color: var(--accent-primary);
    margin-left: 0.04em;
  }

  .brand-badge {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    padding: 0.18rem 0.38rem;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .nav-links {
    display: flex;
    align-items: stretch;
    gap: 0;
    flex: 1;
    min-width: 0;
    justify-content: center;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0 0.9rem;
    transition: color var(--dur-fast) ease;
  }

  .nav-item::after {
    content: "";
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: -1px;
    height: 2px;
    background: var(--accent-primary);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .nav-item:hover {
    color: var(--text-main);
    background: transparent;
  }

  .nav-item.active {
    color: var(--text-main);
    background: transparent;
    box-shadow: none;
  }

  .nav-item.active::after,
  .nav-item:hover::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .theme-select-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--border-color);
    padding: 0.28rem 0.5rem;
    cursor: pointer;
    transition: border-color var(--dur-fast) ease;
  }

  .theme-select-wrapper:hover {
    border-color: var(--text-main);
  }

  .util-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .theme-select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    color: var(--text-main);
    border: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    outline: none;
  }

  .theme-select option {
    background: var(--bg-surface);
    color: var(--text-main);
    text-transform: none;
  }

  .util-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    padding: 0.34rem 0.5rem;
    cursor: pointer;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease, opacity var(--dur-fast) ease;
  }

  .util-btn:hover {
    color: var(--text-main);
    border-color: var(--text-main);
  }

  .util-btn:active,
  .github-btn:active,
  .theme-select-wrapper:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  .util-btn[aria-pressed="false"] {
    opacity: 0.45;
  }

  .audio-mark {
    width: 6px;
    height: 6px;
    background: var(--accent-primary);
    display: inline-block;
  }

  .util-btn[aria-pressed="false"] .audio-mark {
    background: var(--text-dim);
  }

  .github-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--text-main);
    color: var(--bg-base);
    border: 1px solid var(--text-main);
    padding: 0.38rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .github-btn:hover {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #ffffff;
    transform: none;
  }

  .v-tag {
    font-size: 0.7rem;
    line-height: 1;
    opacity: 0.7;
  }

  @media (max-width: 1020px) {
    .nav-links {
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .nav-links::-webkit-scrollbar {
      display: none;
    }
    .nav-item {
      padding: 0 0.6rem;
      white-space: nowrap;
    }
    .theme-select-wrapper .util-label {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: 58px;
      gap: 0.9rem;
      flex-wrap: wrap;
      padding-block: 0.55rem;
    }
    .theme-select-wrapper,
    .util-btn,
    .github-btn {
      min-height: 38px;
    }
    .nav-item {
      min-height: 40px;
    }
    .nav-links {
      order: 3;
      flex: 1 0 100%;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      justify-content: flex-start;
      border-top: 1px solid var(--border-dim);
      padding-top: 0.4rem;
      margin-top: 0.1rem;
    }
    .nav-item {
      padding: 0.25rem 0.55rem 0.3rem;
      font-size: 0.62rem;
    }
    .nav-item::after {
      left: 0.55rem;
      right: 0.55rem;
    }
    .brand-badge {
      display: none;
    }
    .github-btn {
      padding: 0.38rem 0.5rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--header-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-contrast: more) {
    .site-header {
      background: var(--header-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom-color: var(--text-main);
    }
  }

  @media (max-width: 420px) {
    .header-actions .github-btn span:first-child {
      display: none;
    }
    .header-actions .github-btn::before {
      content: "GitHub";
      font-size: 0.6rem;
    }
  }
</style>

<script>
  function setupNavigation() {
    const themeSwitcher = document.getElementById('theme-switcher') as HTMLSelectElement | null;
    let currentTheme = localStorage.getItem('shae-theme') ||
      (document.documentElement.getAttribute('data-theme') || 'light');
    if (currentTheme === 'oled') currentTheme = 'vantablack';
    if (!['light', 'dark', 'vantablack'].includes(currentTheme)) currentTheme = 'light';

    if (themeSwitcher) {
      themeSwitcher.value = currentTheme;
      themeSwitcher.onchange = () => {
        const selected = themeSwitcher.value;
        document.documentElement.setAttribute('data-theme', selected);
        localStorage.setItem('shae-theme', selected);
      };
    }

    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-links .nav-item');
    navLinks.forEach((link) => {
      const rawHref = link.getAttribute('href') || '/';
      const hrefClean = rawHref.replace(/\/$/, '') || '/';
      const isActive = hrefClean === '/'
        ? currentPath === '/'
        : currentPath === hrefClean || currentPath.startsWith(hrefClean + '/');
      link.classList.toggle('active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });

    const audioBtn = document.getElementById('toggle-audio-btn');
    if (audioBtn) {
      const syncAudioState = () => {
        const muted = localStorage.getItem('shae-audio-muted') === 'true';
        audioBtn.setAttribute('aria-pressed', String(!muted));
      };
      syncAudioState();
      audioBtn.onclick = () => {
        window.dispatchEvent(new CustomEvent('toggle-audio'));
        syncAudioState();
      };
    }
  }

  document.addEventListener('astro:page-load', setupNavigation);
</script>

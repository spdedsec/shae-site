---
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Overview', href: '/' },
  { label: '5-Min Tour', href: '/tour' },
  { label: 'Docs', href: '/docs' },
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Web REPL', href: '/repl' },
];
---

<header class="site-header" transition:name="main-header" transition:persist>
  <div class="container header-inner">
    <div class="logo-area">
      <a href="/" class="brand-link">
        <span class="logo-text">shae</span>
        <span class="logo-dot"></span>
      </a>
      <span class="tagline-pill">no bullshit</span>
    </div>

    <nav class="nav-links">
      {navItems.map((item) => {
        const isActive = cleanPath === item.href.replace(/\/$/, '') || (item.href !== '/' && cleanPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={['nav-item', { active: isActive }]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <!-- Theme Switcher Selector -->
      <div class="theme-select-wrapper">
        <select id="theme-switcher" class="theme-select" title="Switch Theme">
          <option value="light">🔴 Core (White/Red)</option>
          <option value="oled">⚫ OLED Dark</option>
          <option value="cyber">🟢 Phosphor Matrix</option>
          <option value="amber">🟡 Solar Amber</option>
        </select>
      </div>

      <button id="toggle-audio-btn" class="util-btn" title="Toggle Mechanical Audio">
        <span class="icon">🔊</span>
      </button>

      <a
        href="https://github.com/spdedsec/shae"
        target="_blank"
        rel="noopener noreferrer"
        class="github-btn"
      >
        <span>GitHub</span>
        <span class="v-tag">v0.2</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-dim);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 1.5rem;
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--text-main);
  }

  .logo-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: var(--accent-primary);
    border-radius: 50%;
    margin-left: 3px;
    box-shadow: 0 0 10px var(--accent-primary-glow);
  }

  .tagline-pill {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    letter-spacing: -0.01em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-item {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .nav-item:hover {
    color: var(--text-main);
    background: var(--bg-hover);
  }

  .nav-item.active {
    color: var(--accent-primary);
    background: var(--accent-badge-bg);
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .theme-select-wrapper {
    position: relative;
  }

  .theme-select {
    appearance: none;
    -webkit-appearance: none;
    background: var(--bg-surface);
    color: var(--text-main);
    border: 1px solid var(--border-dim);
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    outline: none;
    transition: all 0.15s ease;
  }

  .theme-select:hover {
    border-color: var(--border-bright);
    background: var(--bg-hover);
  }

  .util-btn {
    background: var(--bg-surface);
    color: var(--text-muted);
    border: 1px solid var(--border-dim);
    border-radius: 9999px;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.82rem;
    transition: all 0.15s ease;
  }

  .util-btn:hover {
    color: var(--text-main);
    border-color: var(--border-bright);
    background: var(--bg-hover);
  }

  .github-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--text-main);
    color: var(--bg-base);
    border: 1px solid var(--text-main);
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .github-btn:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .v-tag {
    font-size: 0.68rem;
    opacity: 0.7;
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }
  }
</style>

<script>
  function setupNavigation() {
    const themeSwitcher = document.getElementById('theme-switcher') as HTMLSelectElement;
    const currentTheme = localStorage.getItem('shae-theme') || 'light';
    
    if (themeSwitcher) {
      themeSwitcher.value = currentTheme;
      themeSwitcher.onchange = () => {
        const selected = themeSwitcher.value;
        document.documentElement.setAttribute('data-theme', selected);
        localStorage.setItem('shae-theme', selected);
      };
    }

    const audioBtn = document.getElementById('toggle-audio-btn');
    if (audioBtn) {
      audioBtn.onclick = () => {
        window.dispatchEvent(new CustomEvent('toggle-audio'));
        const muted = localStorage.getItem('shae-audio-muted') === 'true';
        audioBtn.style.opacity = muted ? '0.4' : '1.0';
      };
      if (localStorage.getItem('shae-audio-muted') === 'true') {
        audioBtn.style.opacity = '0.4';
      }
    }
  }

  document.addEventListener('astro:page-load', setupNavigation);
</script>

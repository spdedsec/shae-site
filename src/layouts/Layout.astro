---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SoundEffects from '../components/SoundEffects.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Shae — Fast, Simple, Real",
  description = "A programming language. It runs, it does stuff, it leaves you alone. Zero ceremony, built-in servers, effortless concurrency."
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    
    <!-- Instant Zero-FOUC Theme Init -->
    <script is:inline>
      (function() {
        try {
          let savedTheme = localStorage.getItem('shae-theme');
          if (savedTheme === 'oled') savedTheme = 'vantablack';
          if (!savedTheme || !['light', 'dark', 'vantablack'].includes(savedTheme)) {
            savedTheme = 'light';
          }
          document.documentElement.setAttribute('data-theme', savedTheme);
        } catch (_) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Navigation />
    <main class="page-content">
      <slot />
    </main>
    <Footer />
    <SoundEffects />

    <script>
      // Seamlessly sync theme before DOM swap to avoid View Transitions flash
      document.addEventListener('astro:before-swap', (ev: any) => {
        let savedTheme = localStorage.getItem('shae-theme') || 'light';
        if (savedTheme === 'oled') savedTheme = 'vantablack';
        if (!['light', 'dark', 'vantablack'].includes(savedTheme)) savedTheme = 'light';
        if (ev.newDocument) {
          ev.newDocument.documentElement.setAttribute('data-theme', savedTheme);
        }
      });

      // Confirm theme persistence after swap and sync UI controls
      document.addEventListener('astro:after-swap', () => {
        let savedTheme = localStorage.getItem('shae-theme') || 'light';
        if (savedTheme === 'oled') savedTheme = 'vantablack';
        if (!['light', 'dark', 'vantablack'].includes(savedTheme)) savedTheme = 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);

        const switcher = document.getElementById('theme-switcher') as HTMLSelectElement | null;
        if (switcher && switcher.value !== savedTheme) {
          switcher.value = savedTheme;
        }
      });
    </script>
  </body>
</html>

<style>
  .page-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }
</style>

---
import Layout from '../layouts/Layout.astro';

const codeExamples = [
  {
    id: 'jit-ssa',
    label: 'JIT SSA',
    badge: 'Chunk 28 & Cranelift',
    filename: 'fibonacci_jit.shae',
    description: 'Cranelift JIT SSA compiler detects hot execution loops at invocation threshold and generates native machine code on the fly.',
    code: `// Cranelift JIT SSA: Compiles hot loops into native machine code
fn fibonacci(n) {
    if n <= 1 { return n }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

// Warm up invocation threshold (JIT_THRESHOLD = 20)
// Cranelift SSA tier kicks in, executing directly as silicon machine code
let result = fibonacci(35)
print("Computed fib(35) in native SSA tier: {result}")

// Direct LLVM 18 SSA IR emission is also built-in:
// $ shae llvm fibonacci_jit.shae -c -o fib_native
// $ ./fib_native  # Standalone zero-dependency executable`
  },
  {
    id: 'actor-reload',
    label: 'Actor Hot-Reload',
    badge: 'Chunk 30',
    filename: 'vault_daemon.shae',
    description: 'Lightweight actor threads with unbounded FIFO mailboxes and zero-downtime hot-code swapping without dropping state or messages.',
    code: `use { spawn_actor, ask } from "std:actor"

// V1 Actor: Processing banking transactions with persistent state
fn vault_v1(state, msg) {
    match msg {
        { type: "deposit", amount } => state + amount,
        { type: "balance" } => { print("Current vault balance: \${state}"); state },
        _ => state
    }
}

let vault = spawn_actor(vault_v1, 1000)
vault.send({ type: "deposit", amount: 500 })

// Chunk 30: Hot-reload active handler while daemon is running!
// Preserves thread execution, active state, and pending FIFO queue
vault.reload(fn(state, msg) {
    match msg {
        { type: "audit" } => { print("AUDIT: Vault holds \${state}"); state },
        _ => vault_v1(state, msg)
    }
})

let audited = vault.ask({ type: "audit" })`
  },
  {
    id: 'zero-copy',
    label: 'Zero-Copy Buffer',
    badge: 'Chunk 29',
    filename: 'packet_codec.shae',
    description: 'Typed memory buffers sharing Arc storage without heap copying, with endian binary I/O and C-struct packing.',
    code: `use { ByteBuffer, pack, unpack } from "std:buffer"

// Allocate raw contiguous memory buffer
let raw = ByteBuffer.new(1024)

// Binary struct packing: 32-bit uint, two 16-bit ints, 4-char magic
let packet = pack("<I2h4s", 0xDEADBEEF, 128, -42, "SHAE")

// Zero-copy slice: creates a view sharing Arc<RwLock<Vec<u8>>> storage
let header_slice = packet.slice(0, 4)
let magic = header_slice.read_u32_le(0)

print("Decoded magic header: 0x{magic:X}") // 0xDEADBEEF
print("Backing memory refcount: 2 (zero heap allocations)")`
  },
  {
    id: 'tls-mesh',
    label: 'TLS Mesh',
    badge: 'Chunk 21',
    filename: 'cluster_mesh.shae',
    description: 'Encrypted distributed actor clustering over Rustls 0.23 with mutual TLS (mTLS), cookie handshake, and bully leader election.',
    code: `use { ClusterNode } from "std:actor:cluster"

// Initialize encrypted TLS node in cluster mesh
let node = ClusterNode.new({
    name: "worker_alpha",
    bind: "0.0.0.0:9001",
    tls_cert: "certs/node.crt",
    tls_key: "certs/node.key",
    cluster_secret: env("CLUSTER_SECRET")
})

// Peer mutual authentication over encrypted TCP framing
node.connect("worker_beta@10.0.0.2:9001")

// Remote actor dispatch across network with length-delimited framing
let remote_worker = node.actor("pricing_worker@worker_beta")
let quote = await remote_worker.ask({ symbol: "EURUSD", volume: 100000 })

print("Received encrypted cluster quote: {quote.price}")`
  },
  {
    id: 'async-pipe',
    label: 'Async Coroutines',
    badge: 'Chunk 22',
    filename: 'async_pipeline.shae',
    description: 'First-class asynchronous tasks with cooperative scheduling, combinators, and functional Elixir-style pipe operators.',
    code: `use { spawn, all, sleep } from "std:async"

// First-class coroutines with cooperative task scheduling
let task1 = spawn(fn() { sleep(40); return [12, 45, 88, 92, 105] })
let task2 = spawn(fn() { sleep(60); return [33, 76, 42, 19, 1337] })

// Await multiple asynchronous tasks in parallel
let [batch1, batch2] = await all([task1, task2])

// Elixir-style functional pipelines with zero callback boilerplate
let top_scores = batch1.concat(batch2)
    |> filter(fn(score) { score >= 50 })
    |> map(fn(score) { score * 1.05 })
    |> sort()
    |> reverse()

print("Top normalized scores: {top_scores}")`
  }
];

const architecturalMetrics = [
  { value: '3 ms', label: 'Cold Startup', note: '11.6x faster than Python 3.12, 21.6x faster than Node.js' },
  { value: '4.2 MB', label: 'Base Memory', note: 'Stack VM with mark-and-sweep GC root tracing' },
  { value: '138k', label: 'Slices / Sec', note: 'Zero-copy Arc buffer slicing throughput (Chunk 29)' },
  { value: '20.8k', label: 'Messages / Sec', note: 'Multi-threaded actor mailbox throughput (Chunk 14)' },
  { value: '14 Modules', label: 'Self-Hosting', note: 'Pure-Shae compiler suite emitting ELF, PE, Wasm & LLVM' },
  { value: 'LLVM 18', label: 'Native Backend', note: 'Direct SSA IR generation with Clang -O2 standalone binaries' }
];

const comparisons = [
  {
    lang: 'Python',
    verdict: 'GIL & Startup Latency',
    flaw: 'Clean syntax, but real threads are constrained by the Global Interpreter Lock, cold startup averages 35ms, and dependency resolution often breaks across environments.',
    shaeAdvantage: 'Shae boots in 3ms with genuine OS threads and lightweight actors, zero venv requirements, and single-binary packaging.'
  },
  {
    lang: 'JavaScript',
    verdict: 'Tooling & Memory Bloat',
    flaw: 'Runs everywhere, but single-threaded event loop blocking degrades CPU tasks, type coercion produces subtle bugs, and small projects require hundreds of megabytes in dependencies.',
    shaeAdvantage: 'Zero external node_modules needed. Web servers, cryptographic ciphers, SQLite, and regex engines are natively compiled into the runtime.'
  },
  {
    lang: 'Rust',
    verdict: 'Borrow Friction in Scripts',
    flaw: 'Unbeatable performance and memory safety, but writing rapid pipelines, dynamic configurations, or prototypes requires wrestling with lifetimes and complex traits.',
    shaeAdvantage: 'Instant iteration without lifetime friction. When maximum raw performance is required, direct LLVM SSA compilation produces standalone binaries.'
  },
  {
    lang: 'Go',
    verdict: 'Repetitive Error Boilerplate',
    flaw: 'Clean concurrent channels, but codebases suffer from repetitive error-handling boilerplate, lack pattern matching with guards, and offer no functional pipe transformations.',
    shaeAdvantage: 'Expressive pattern matching with guards, structured try/catch exception frames with preserved stacks, and first-class functional pipelines (|).'
  }
];
---

<Layout
  title="Shae — A Modern Systems Scripting Language"
  description="Strict, expressive, and fast as silicon. Dual-engine runtime, Cranelift JIT, direct LLVM 18 SSA emission, zero-copy buffers, and distributed actor mesh."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge-row animate-fade-up">
        <span class="badge badge-red">
          <span class="pulse-indicator"></span> v0.4.0 Release
        </span>
        <span class="badge">290+ Tests Passing</span>
        <span class="badge">Dual-Engine Parity</span>
        <span class="badge">Pure-Shae Self-Hosting</span>
      </div>

      <h1 class="hero-title animate-fade-up delay-100">
        A Modern Systems Scripting Language.<br />
        <span class="hero-serif-italic">Strict, Expressive, and Fast as Silicon.</span>
      </h1>

      <p class="hero-subtitle animate-fade-up delay-200">
        Built from first principles with zero external dependencies. Dual-engine runtime featuring a stack bytecode VM, 
        Cranelift JIT compilation, direct LLVM 18 SSA generation, zero-copy memory buffers, and fault-tolerant actor mesh.
      </p>

      <div class="hero-actions animate-fade-up delay-300">
        <a href="/download" class="btn btn-primary">
          <span>Get Started</span>
          <span class="arrow-glyph">→</span>
        </a>
        <a href="/docs" class="btn btn-secondary">
          <span>Documentation &amp; 42-Page Guide</span>
        </a>
        <a href="/features" class="btn btn-secondary">
          <span>Explore Architecture (Chunks 1–31)</span>
        </a>
      </div>

      <!-- Quickstart Terminal Card -->
      <div class="quickstart-wrapper animate-fade-up delay-400">
        <div class="terminal-window">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="terminal-dot dot-red"></span>
              <span class="terminal-dot dot-yellow"></span>
              <span class="terminal-dot dot-green"></span>
            </div>
            <div class="terminal-title">shae // universal-installer</div>
            <div class="terminal-tag">POSIX &amp; Windows</div>
          </div>
          <div class="terminal-body quickstart-body">
            <div class="command-row">
              <span class="prompt-symbol">$</span>
              <span class="command-text" id="install-command">curl -fsSL https://shae-site.vercel.app/install.sh | bash</span>
              <button class="copy-terminal-btn" id="copy-quickstart-btn" title="Copy to clipboard" aria-label="Copy install command">
                <span class="btn-text" id="copy-btn-text">COPY</span>
              </button>
            </div>
            <div class="terminal-feedback">
              <span class="comment-line"># Installs standalone binary, standard libraries, and VS Code extension</span>
              <span class="comment-line"># Then run your first program:</span>
              <span class="exec-line"><span class="prompt-symbol">$</span> shae run hello.shae</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Code Tabs Showcase -->
  <section class="showcase-section">
    <div class="container">
      <div class="section-intro">
        <span class="badge badge-red">Interactive Showcase</span>
        <h2 class="section-heading">Systems Capabilities in Modern Syntax</h2>
        <p class="section-desc">
          Explore Shae's native features across JIT compilation, actor hot-reloading, zero-copy buffers, encrypted clusters, and coroutines.
        </p>
      </div>

      <div class="code-showcase-window">
        <!-- Showcase Navigation Bar -->
        <div class="showcase-nav" role="tablist" aria-label="Shae Code Showcase Tabs">
          {codeExamples.map((item, idx) => (
            <button
              class:list={['showcase-tab', { active: idx === 0 }]}
              data-tab-target={item.id}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`panel-${item.id}`}
              id={`tab-${item.id}`}
            >
              <span class="tab-label">{item.label}</span>
              <span class="tab-badge">{item.badge}</span>
            </button>
          ))}
        </div>

        <!-- Showcase Code Panels -->
        <div class="showcase-body">
          {codeExamples.map((item, idx) => (
            <div
              id={`panel-${item.id}`}
              class:list={['code-panel', { active: idx === 0 }]}
              role="tabpanel"
              aria-labelledby={`tab-${item.id}`}
            >
              <div class="panel-meta-bar">
                <div class="meta-left">
                  <span class="file-glyph">📄</span>
                  <span class="file-name">{item.filename}</span>
                  <span class="panel-desc">{item.description}</span>
                </div>
                <button
                  class="panel-copy-btn"
                  data-snippet={item.code}
                  aria-label={`Copy ${item.filename} code`}
                >
                  <span class="copy-icon">📋</span>
                  <span class="panel-copy-label">Copy Code</span>
                </button>
              </div>
              <div class="editor-viewport">
                <pre><code class="language-shae">{item.code}</code></pre>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Architectural Metrics Strip -->
  <section class="metrics-section">
    <div class="container">
      <div class="metrics-header">
        <span class="badge">Silicon Benchmarks</span>
        <h2 class="section-heading">Architectural Metrics &amp; Performance Telemetry</h2>
        <p class="section-desc">
          Measured with <code>shae bench</code> on release builds. Zero startup overhead, minimal memory consumption, and wire-speed throughput.
        </p>
      </div>

      <div class="metrics-grid">
        {architecturalMetrics.map((m) => (
          <div class="metric-card card glass-card">
            <div class="metric-value">{m.value}</div>
            <div class="metric-label">{m.label}</div>
            <div class="metric-note">{m.note}</div>
          </div>
        ))}
      </div>

      <div class="metrics-cta-row">
        <a href="/benchmarks" class="editorial-link">
          View Full Benchmark Suite &amp; Telemetry Report (ops/sec) →
        </a>
      </div>
    </div>
  </section>

  <!-- The Editorial Reality Section -->
  <section class="editorial-reality-section">
    <div class="container">
      <div class="section-intro">
        <span class="badge badge-red">Engineering Philosophy</span>
        <h2 class="section-heading">The Editorial Reality: Why Shae?</h2>
        <p class="section-desc">
          Modern systems engineering has accumulated friction. Shae is engineered to restore balance between expressive ergonomics and machine reality.
        </p>
      </div>

      <div class="comparison-grid">
        {comparisons.map((c) => (
          <div class="compare-card card">
            <div class="compare-head">
              <h3 class="compare-title">{c.lang}</h3>
              <span class="verdict-tag">{c.verdict}</span>
            </div>
            <p class="compare-flaw">{c.flaw}</p>
            <div class="compare-advantage">
              <div class="adv-label">The Shae Advantage:</div>
              <p class="adv-text">{c.shaeAdvantage}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Feature Deep Dive Link Banner -->
      <div class="deepdive-banner card glass-card">
        <div class="deepdive-content">
          <span class="badge badge-red">Chunks 1–31 Verified</span>
          <h3 class="deepdive-title">Explore the Complete Engineering Pipeline</h3>
          <p class="deepdive-text">
            From the Pratt parser and AST evaluator to the Cranelift JIT, zero-copy <code>std:buffer</code>, 
            Rustls TLS cluster mesh, and pure-Shae self-hosting compiler suite.
          </p>
        </div>
        <div class="deepdive-actions">
          <a href="/features" class="btn btn-primary">Features &amp; Architecture →</a>
          <a href="/docs" class="btn btn-secondary">Read 42-Page Publication Guide</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section Styling */
  .hero-section {
    padding: 5rem 0 3.5rem;
    position: relative;
    text-align: center;
  }

  .hero-container {
    max-width: 960px;
    margin: 0 auto;
  }

  .hero-badge-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .pulse-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-primary, #8b0000);
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.15;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.025em;
    margin-bottom: 1.35rem;
  }

  .hero-serif-italic {
    font-style: italic;
    font-weight: 400;
    color: var(--text-main);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 780px;
    margin: 0 auto 2.25rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }

  .arrow-glyph {
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .arrow-glyph {
    transform: translateX(3px);
  }

  /* Quickstart Terminal Card */
  .quickstart-wrapper {
    max-width: 760px;
    margin: 0 auto;
    text-align: left;
  }

  .quickstart-body {
    padding: 1.25rem 1.5rem;
  }

  .command-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: #f1f5f9;
  }

  .prompt-symbol {
    color: var(--accent-primary, #f43f5e);
    font-weight: 700;
    user-select: none;
  }

  .command-text {
    flex: 1;
    overflow-x: auto;
    white-space: nowrap;
    padding-bottom: 2px;
  }

  .copy-terminal-btn {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #f1f5f9;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .copy-terminal-btn:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .terminal-feedback {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.82rem;
    font-family: var(--font-mono);
    opacity: 0.7;
  }

  .comment-line {
    color: #94a3b8;
  }

  .exec-line {
    color: #e2e8f0;
    margin-top: 0.25rem;
  }

  .terminal-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Interactive Code Showcase */
  .showcase-section {
    padding: 4.5rem 0 3.5rem;
  }

  .section-intro {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }

  .section-heading {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 700;
    margin: 0.75rem 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .code-showcase-window {
    background: var(--bg-code, #18181b);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.12));
    border-radius: var(--card-radius, 8px);
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
  }

  .showcase-nav {
    display: flex;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .showcase-nav::-webkit-scrollbar {
    display: none;
  }

  .showcase-tab {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.35rem;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s ease;
  }

  .showcase-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.04);
  }

  .showcase-tab.active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
    border-bottom-color: var(--accent-primary, #f43f5e);
  }

  .tab-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  .code-panel {
    display: none;
  }

  .code-panel.active {
    display: block;
  }

  .panel-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .file-name {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: #38bdf8;
    font-weight: 600;
  }

  .panel-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .panel-copy-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-serif);
    font-size: 0.8rem;
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .panel-copy-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
  }

  .editor-viewport {
    padding: 1.5rem;
    overflow-x: auto;
  }

  .editor-viewport pre {
    margin: 0;
  }

  .editor-viewport code {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.65;
    color: #f8fafc;
  }

  /* Metrics Section */
  .metrics-section {
    padding: 4rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-surface);
  }

  .metrics-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .metric-card {
    padding: 1.5rem;
    text-align: center;
  }

  .metric-value {
    font-family: 'Times New Roman', Times, serif;
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--accent-primary, #8b0000);
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }

  .metric-label {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .metric-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .metrics-cta-row {
    text-align: center;
    margin-top: 1rem;
  }

  /* Editorial Reality Section */
  .editorial-reality-section {
    padding: 4.5rem 0 5.5rem;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .compare-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .compare-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .compare-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .verdict-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-primary);

---
import Layout from '../layouts/Layout.astro';

const codeExamples = [
  {
    id: 'server',
    label: 'HTTP Server',
    filename: 'server.shae',
    code: `// Spin up a concurrent web server in 5 lines. No npm. No cargo.
serve(8080, fn(req) {
    if req.path == "/api/status" {
        return { status: 200, body: json({ status: "alive", uptime: 420 }) }
    }
    return { status: 404, body: "Not found" }
})

print("Listening on http://localhost:8080")`
  },
  {
    id: 'concurrency',
    label: 'Tasks & Threads',
    filename: 'concurrency.shae',
    code: `// Real OS threads with Task handles. No async/await colored functions.
let worker = spawn(fn() {
    print("Crunching computation in background thread...")
    return 42 * 1337
})

// Do other work here while worker computes...
let result = worker.join()
print("Worker delivered: {result}")`
  },
  {
    id: 'pipeline',
    label: 'Data Pipelines',
    filename: 'pipeline.shae',
    code: `// Elixir-style pipe operator. Chain transformations without callbacks.
let scores = [12, 45, 88, 92, 105, 33, 76]

let top_normalized = scores
    |> filter(fn(x) { x >= 50 })
    |> map(fn(x) { x / 10 })
    |> sort()

print("Normalized scores: {top_normalized}")`
  },
  {
    id: 'matching',
    label: 'Pattern Matching',
    filename: 'match.shae',
    code: `// Expressive data shapes and pattern matching.
enum Status {
    Pending,
    Active(user),
    Failed(reason)
}

fn inspect(s) {
    match s {
        Status.Pending => "Waiting for authorization",
        Status.Active(u) => "User {u} is currently online",
        Status.Failed(err) => "Encountered error: {err}",
        _ => "Unknown state"
    }
}`
  }
];
---

<Layout
  title="Shae — A programming language that just does its job"
  description="A programming language. It runs, it does stuff, it leaves you alone. Simple, fast as fuck, zero ceremony."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge-row">
        <span class="badge badge-red">
          <span class="dot"></span> Shae v0.2.0
        </span>
        <span class="badge">Pure Rust Engine</span>
        <span class="badge">Zero Ceremony</span>
      </div>

      <h1 class="hero-title">
        A programming language.<br />
        <span class="highlight-text">It runs, it does stuff,</span><br />
        it leaves you alone.
      </h1>

      <p class="hero-subtitle">
        No ceremony. No drama. No compiler lectures about lifetimes.
        Write your code, ship a binary, and move on with your life.
      </p>

      <div class="hero-actions">
        <a href="/tour" class="btn btn-primary">
          <span>Take the 5-Min Tour</span>
          <span>→</span>
        </a>
        <a href="/repl" class="btn btn-secondary">
          <span>Launch Web REPL</span>
        </a>
      </div>

      <!-- Quick Install Box -->
      <div class="install-box">
        <div class="install-prompt">$</div>
        <input
          type="text"
          readonly
          value="curl -sSL https://shae-site.vercel.app/install.sh | bash"
          class="install-input"
          id="install-cmd"
        />
        <button class="copy-btn" id="copy-install-btn" title="Copy to clipboard">
          <span class="copy-label">COPY</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Interactive Code Tabs Showcase -->
  <section class="showcase-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-red">Syntax</span>
        <h2>Code that doesn't waste your afternoon</h2>
        <p>No semicolons. No parentheses around conditions. Everything built-in.</p>
      </div>

      <div class="terminal-window">
        <div class="terminal-nav">
          <div class="tab-buttons" role="tablist">
            {codeExamples.map((item, idx) => (
              <button
                class:list={['code-tab-btn', { active: idx === 0 }]}
                data-tab-target={item.id}
              >
                <span>{item.label}</span>
              </button>
            ))}
          </div>
          <div class="terminal-right-tag">
            <span>shae // v0.2.0</span>
          </div>
        </div>

        <div class="terminal-editor-body">
          {codeExamples.map((item, idx) => (
            <div
              id={`tab-content-${item.id}`}
              class:list={['code-panel', { active: idx === 0 }]}
            >
              <div class="panel-meta">
                <span class="filename">{item.filename}</span>
                <button class="panel-copy-btn" data-code={item.code}>Copy</button>
              </div>
              <pre><code>{item.code}</code></pre>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- The "No Bullshit" Reality Section -->
  <section class="manifesto-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-red">The Real Reality</span>
        <h2>Why build another language?</h2>
        <p>Because modern programming has gotten unnecessarily complicated.</p>
      </div>

      <div class="comparison-grid">
        <div class="compare-card card">
          <div class="compare-header">
            <h3>Python</h3>
            <span class="verdict-tag">GIL &amp; Venv Hell</span>
          </div>
          <p class="compare-text">
            Simple syntax, until you need real threads and hit the GIL, or your team loses two days debugging broken virtual environments.
          </p>
        </div>

        <div class="compare-card card">
          <div class="compare-header">
            <h3>JavaScript</h3>
            <span class="verdict-tag">Tooling Fatigue</span>
          </div>
          <p class="compare-text">
            Runs everywhere, but <code>[] + {}</code> evaluates to <code>"[object Object]"</code>, and you need 400MB of <code>node_modules</code> just to print a date.
          </p>
        </div>

        <div class="compare-card card">
          <div class="compare-header">
            <h3>Rust</h3>
            <span class="verdict-tag">Borrow Marathon</span>
          </div>
          <p class="compare-text">
            Unbeatable speed, but writing a simple prototype turns into an intellectual marathon with compiler lifetime errors.
          </p>
        </div>

        <div class="compare-card card">
          <div class="compare-header">
            <h3>Go</h3>
            <span class="verdict-tag">Boilerplate Fatigue</span>
          </div>
          <p class="compare-text">
            Clean concurrency, but half of every codebase is repetitive typing of <code>if err != nil</code> on every second line.
          </p>
        </div>
      </div>

      <!-- The Shae Spotlight -->
      <div class="shae-spotlight-card">
        <div class="spotlight-header">
          <span class="spotlight-badge">THE SHAE WAY</span>
          <h3>The sweet spot between speed, sanity, and zero drama</h3>
        </div>

        <div class="spotlight-features">
          <div class="s-feat">
            <div class="s-num">01</div>
            <div>
              <strong>Built-in Web Server</strong>
              <p>Spin up concurrent HTTP endpoints in 5 lines without touching a package manager.</p>
            </div>
          </div>
          <div class="s-feat">
            <div class="s-num">02</div>
            <div>
              <strong>Thread Concurrency with Handles</strong>
              <p>Spawn genuine OS threads with <code>spawn()</code> and join them with <code>.join()</code> when you're ready.</p>
            </div>
          </div>
          <div class="s-feat">
            <div class="s-num">03</div>
            <div>
              <strong>Graceful Crash Prevention</strong>
              <p>Real <code>try/catch</code> blocks and readable stack traces. Servers don't crash on unhandled routes.</p>
            </div>
          </div>
          <div class="s-feat">
            <div class="s-num">04</div>
            <div>
              <strong>Human Linter with Typo Hints</strong>
              <p>Typo a variable? <code>shae check</code> tells you: <em>"💡 Hint: Did you mean counter?"</em></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Single Binary Toolchain -->
  <section class="cli-section">
    <div class="container">
      <div class="cli-box card">
        <div class="cli-content">
          <span class="badge badge-red">Single Binary Toolchain</span>
          <h2>Everything you need. Zero plugins.</h2>
          <p>Linter, REPL, test runner, project generator, and formatting built into one fast Rust binary.</p>
          <div class="cli-cmds">
            <code>shae               # Start interactive REPL</code>
            <code>shae check app.shae # Static linter &amp; typo hints</code>
            <code>shae test           # Run tests (*_test.shae)</code>
            <code>shae new my_app     # Scaffold fresh project</code>
          </div>
        </div>
        <div class="cli-action">
          <a href="/docs" class="btn btn-dark">Read the CLI Docs →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding: 6rem 0 4rem;
    position: relative;
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge-row {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--accent-primary);
    border-radius: 50%;
  }

  .hero-title {
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .highlight-text {
    color: var(--accent-primary);
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 640px;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .install-box {
    display: flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 9999px;
    padding: 0.45rem 0.6rem 0.45rem 1.2rem;
    max-width: 520px;
    width: 100%;
    box-shadow: var(--card-shadow);
  }

  .install-prompt {
    color: var(--accent-primary);
    font-weight: 700;
    font-family: var(--font-mono);
    margin-right: 0.75rem;
  }

  .install-input {
    background: transparent;
    border: none;
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    width: 100%;
    outline: none;
  }

  .copy-btn {
    background: var(--text-main);
    color: var(--bg-base);
    border: none;
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .copy-btn:hover {
    opacity: 0.85;
  }

  /* Showcase */
  .showcase-section {
    padding: 4rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0.75rem 0 0.5rem;
    color: var(--text-main);
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .terminal-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0 1rem;
    overflow-x: auto;
  }

  .tab-buttons {
    display: flex;
    gap: 0.25rem;
  }

  .code-tab-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    padding: 0.85rem 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 500;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.15s ease;
  }

  .code-tab-btn:hover {
    color: #fff;
  }

  .code-tab-btn.active {
    color: #fff;
    border-bottom-color: var(--accent-primary);
    font-weight: 600;
  }

  .terminal-right-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .terminal-editor-body {
    padding: 1.75rem;
  }

  .code-panel {
    display: none;
  }

  .code-panel.active {
    display: block;
  }

  .panel-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .filename {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .panel-copy-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .panel-copy-btn:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .code-panel pre {
    margin: 0;
    overflow-x: auto;
  }

  .code-panel code {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.7;
    color: #f1f5f9;
  }

  /* Comparison Matrix */
  .manifesto-section {
    padding: 4.5rem 0;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .compare-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .compare-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .compare-header h3 {
    font-size: 1.2rem;
    color: var(--text-main);
  }

  .verdict-tag {
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-weight: 600;
    background: var(--bg-card-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border-dim);
  }

  .compare-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .compare-text code {
    background: var(--bg-surface);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--accent-primary);
  }

  /* Shae Spotlight */
  .shae-spotlight-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: var(--card-radius);
    padding: 3rem;
    box-shadow: var(--elevated-shadow);
  }

  .spotlight-badge {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--accent-primary);
    background: var(--accent-badge-bg);
    border: 1px solid var(--accent-badge-border);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .shae-spotlight-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 2.5rem;
  }

  .spotlight-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }

  .s-feat {
    display: flex;
    gap: 1.25rem;
  }

  .s-num {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent-primary);
  }

  .s-feat strong {
    display: block;
    font-size: 1rem;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .s-feat p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* CLI Section */
  .cli-section {
    padding: 2rem 0 5rem;
  }

  .cli-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2.5rem;
    padding: 3rem;
  }

  .cli-content h2 {
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin: 0.75rem 0 0.5rem;
  }

  .cli-content p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .cli-cmds {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .cli-cmds code {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--text-main);
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    padding: 0.4rem 0.85rem;
  }

  @media (max-width: 768px) {
    .cli-box {
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem;
    }
  }
</style>

<script>
  function setupHomePage() {
    const copyBtn = document.getElementById('copy-install-btn');
    const input = document.getElementById('install-cmd') as HTMLInputElement;

    if (copyBtn && input) {
      copyBtn.onclick = async () => {
        await navigator.clipboard.writeText(input.value);
        const original = copyBtn.innerHTML;
        copyBtn.innerHTML = '<span>COPIED!</span>';
        setTimeout(() => {
          copyBtn.innerHTML = original;
        }, 1800);
      };
    }

    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.code-tab-btn');
    tabBtns.forEach((btn) => {
      btn.onclick = () => {
        tabBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const targetId = btn.dataset.tabTarget;
        document.querySelectorAll('.code-panel').forEach((panel) => {
          panel.classList.remove('active');
        });

        const targetPanel = document.getElementById(`tab-content-${targetId}`);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      };
    });

    document.querySelectorAll<HTMLButtonElement>('.panel-copy-btn').forEach((btn) => {
      btn.onclick = async () => {
        const code = btn.dataset.code;
        if (code) {
          await navigator.clipboard.writeText(code);
          btn.innerText = 'Copied!';
          setTimeout(() => {
            btn.innerText = 'Copy';
          }, 1500);
        }
      };
    });
  }

  document.addEventListener('astro:page-load', setupHomePage);
</script>

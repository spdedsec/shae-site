<script>
  function setupIndexInteractions() {
    // 1. Quickstart Terminal Copy
    const copyQuickBtn = document.getElementById('copy-quickstart-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const installCmd = document.getElementById('install-command');

    if (copyQuickBtn && copyBtnText && installCmd) {
      copyQuickBtn.onclick = () => {
        const textToCopy = installCmd.innerText.trim();
        navigator.clipboard.writeText(textToCopy).then(() => {
          copyBtnText.innerText = 'COPIED ✓';
          copyQuickBtn.style.background = 'rgba(34, 197, 94, 0.25)';
          copyQuickBtn.style.borderColor = 'rgba(34, 197, 94, 0.5)';
          setTimeout(() => {
            copyBtnText.innerText = 'COPY';
            copyQuickBtn.style.background = '';
            copyQuickBtn.style.borderColor = '';
          }, 2000);
        }).catch(() => {
          copyBtnText.innerText = 'ERROR';
        });
      };
    }

    // 2. Interactive Code Tabs Switching
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.showcase-tab');
    const codePanels = document.querySelectorAll<HTMLElement>('.code-panel');

    tabButtons.forEach((tab) => {
      tab.onclick = () => {
        const targetId = tab.getAttribute('data-tab-target');
        if (!targetId) return;

        tabButtons.forEach((btn) => {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });
        codePanels.forEach((panel) => {
          panel.classList.remove('active');
        });

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        const activePanel = document.getElementById(`panel-${targetId}`);
        if (activePanel) {
          activePanel.classList.add('active');
        }
      };
    });

    // 3. Code Panel Copy Buttons
    const panelCopyBtns = document.querySelectorAll<HTMLButtonElement>('.panel-copy-btn');
    panelCopyBtns.forEach((btn) => {
      btn.onclick = () => {
        const snippet = btn.getAttribute('data-snippet') || '';
        const label = btn.querySelector('.panel-copy-label');
        navigator.clipboard.writeText(snippet).then(() => {
          if (label) label.textContent = 'Copied!';
          btn.style.borderColor = 'rgba(34, 197, 94, 0.6)';
          setTimeout(() => {
            if (label) label.textContent = 'Copy Code';
            btn.style.borderColor = '';
          }, 2000);
        }).catch((err) => {
          console.warn('Clipboard copy denied or failed:', err);
          if (label) label.textContent = 'Copy Failed';
          setTimeout(() => {
            if (label) label.textContent = 'Copy Code';
          }, 2000);
        });
      };
    });
  }

  // Hook into Astro client-side router navigation
  document.addEventListener('astro:page-load', setupIndexInteractions);
</script>

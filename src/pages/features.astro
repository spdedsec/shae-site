---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shae — Features & Architecture" description="Comprehensive architectural breakdown of Chunks 1-31: LLVM SSA, Cranelift JIT, zero-copy buffer, and TLS cluster mesh.">
  <div class="container" style="padding: 5rem 1.5rem; max-width: 900px;">
    <div class="animate-fade-up">
      <span class="badge" style="margin-bottom: 1.25rem;">Milestone 3 Target</span>
      <h1 style="font-size: 2.75rem; margin-bottom: 1.25rem; font-weight: 700;">Features &amp; Architecture</h1>
      <p style="font-size: 1.2rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 2rem;">
        Detailed technical documentation for Chunks 1–31, featuring the LLVM SSA backend (<code>shae llvm</code>), Cranelift JIT compiler, zero-copy <code>std:buffer</code>, and TLS/mTLS cluster mesh.
      </p>
      <div class="card glass-card">
        <h3 style="margin-bottom: 0.75rem;">Chunk 1–31 Architectural Core</h3>
        <p style="color: var(--text-muted); margin-bottom: 1rem;">
          High-performance systems programming with zero-cost abstractions, memory safety without GC, and native concurrency.
        </p>
        <a href="/" class="btn btn-secondary">Return to Overview</a>
      </div>
    </div>
  </div>
</Layout>

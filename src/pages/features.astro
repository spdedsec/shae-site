const actorHotReloadCode = `let actor = use "std:actor"
let cluster = use "std:actor:cluster"

// 1. Spawn initial stateful actor (V1)
let account = actor.spawn({ "balance": 1000, "tx": 0 }, fn(st, msg) {
    if msg["op"] == "deposit" {
        let next = { "balance": st["balance"] + msg["amount"], "tx": st["tx"] + 1 }
        return { "state": next, "reply": next["balance"] }
    }
    return st
})

// 2. Hot-reload to V2 handler with schema migration
let migration_fn = fn(old_st) {
    return {
        "schema_version": 2,
        "funds": old_st["balance"],
        "migrated_tx": old_st["tx"]
    }
}

let v2_handler = fn(st, msg) {
    if msg["op"] == "deposit" {
        let bonus = msg["amount"] / 10 // 10% bonus credit
        let new_funds = st["funds"] + msg["amount"] + bonus
        let next = { "schema_version": 2, "funds": new_funds, "migrated_tx": st["migrated_tx"] + 1 }
        return { "state": next, "reply": { "funds": new_funds, "bonus": bonus } }
    }
    return st
}

account.reload(v2_handler, migration_fn)
let reply = account.ask({ "op": "deposit", "amount": 200 })
print("Deposited under V2 without losing state: {reply['funds']}") // 1220`;


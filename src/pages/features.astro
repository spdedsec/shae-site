<script>
  function setupFeaturesInteractivity() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.cat-tab-btn');
    const searchInput = document.getElementById('chunk-search-input') as HTMLInputElement | null;
    const countDisplay = document.getElementById('chunk-count-display');
    const chunkCards = document.querySelectorAll<HTMLDetailsElement>('.chunk-card');

    let currentCategory = 'all';
    let searchQuery = '';

    function filterChunks() {
      let visibleCount = 0;
      const q = searchQuery.toLowerCase().trim();

      chunkCards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const keywords = card.getAttribute('data-keywords') || '';

        const matchesCat = currentCategory === 'all' || cat === currentCategory;
        const matchesSearch = !q || keywords.includes(q);

        if (matchesCat && matchesSearch) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} of ${chunkCards.length}`;
      }
    }

    // Category tab switching
    tabButtons.forEach((btn) => {
      btn.onclick = () => {
        tabButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.getAttribute('data-filter') || 'all';
        filterChunks();
      };
    });

    // Real-time search filter
    if (searchInput) {
      searchInput.oninput = () => {
        searchQuery = searchInput.value;
        filterChunks();
      };
    }
  }

  // Bind to Astro's View Transitions page load event
  document.addEventListener('astro:page-load', setupFeaturesInteractivity);
</script>

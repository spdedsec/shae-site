  <!-- Deep Dive 3: Zero-Copy Typed Memory Buffers -->
  <section id="zero-copy-buffer" class="section-block">
    <div class="container">
      <div class="deep-dive-card card glass-card animate-fade-up">
        <div class="deep-dive-header">

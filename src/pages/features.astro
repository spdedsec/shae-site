const llvmIrCode = `; ModuleID = 'fibonacci.shae'
target triple = "x86_64-pc-linux-gnu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

declare i32 @printf(i8*, ...)
declare void @exit(i32)

define i64 @fib(i64 %n) {
entry:
  %t.0 = icmp sle i64 %n, 1
  br i1 %t.0, label %then.1, label %else.2

then.1:
  ret i64 %n

else.2:
  %t.1 = sub i64 %n, 1
  %t.2 = call i64 @fib(i64 %t.1)
  %t.3 = sub i64 %n, 2
  %t.4 = call i64 @fib(i64 %t.3)
  %t.5 = add i64 %t.2, %t.4
  ret i64 %t.5
}

define i32 @main() {
entry:
  %res = call i64 @fib(i64 20)
  ret i32 0
}`;

const craneliftJitCode = `// Hot loop automatically triggers Cranelift JIT tiering
fn compute_pi(iterations) {
    let pi = 0.0
    let sign = 1.0
    let i = 0
    while i < iterations {
        pi = pi + sign / (2.0 * i + 1.0)
        sign = -sign
        i = i + 1
    }
    return pi * 4.0
}

// Invocations 1..19: Bytecode VM execution
// Invocation 20: Cranelift JIT compilation triggered
// Invocations 21+: Direct machine code execution (~80,000 ops/sec)
let result = compute_pi(100000)
print("Approximated Pi: {result}")`;


---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shae — Download & Install" description="Single-line universal installer, multi-platform binaries, and VS Code extension setup for Shae v0.4.0.">
  <div class="container" style="padding: 5rem 1.5rem; max-width: 900px;">
    <div class="animate-fade-up">
      <span class="badge" style="margin-bottom: 1.25rem;">Milestone 3 Target</span>
      <h1 style="font-size: 2.75rem; margin-bottom: 1.25rem; font-weight: 700;">Download &amp; Installation</h1>
      <p style="font-size: 1.2rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 2rem;">
        Universal installation scripts, cross-platform binary archives, and official VS Code syntax extension instructions for Shae v0.4.0.
      </p>
      <div class="card glass-card">
        <h3 style="margin-bottom: 0.75rem;">Universal One-Line Installer</h3>
        <div class="terminal-window" style="margin-bottom: 1.25rem;">
          <div class="terminal-body" style="padding: 1rem 1.25rem;">
            <code>curl -fsSL https://shae-site.vercel.app/install.sh | bash</code>
          </div>
        </div>
        <a href="/" class="btn btn-secondary">Return to Overview</a>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';

const startupBenchmarks = [
  { name: 'Shae (Release)', time: '3ms', ms: 3, relative: '1.0x (Instant)', winner: true },
  { name: 'Python 3.12', time: '35ms', ms: 35, relative: '11.6x slower', winner: false },
  { name: 'Node.js v22', time: '65ms', ms: 65, relative: '21.6x slower', winner: false },
  { name: 'Java 17 OpenJDK', time: '120ms', ms: 120, relative: '40.0x slower', winner: false },
];

const memoryBenchmarks = [
  { name: 'Shae (Release)', ram: '4.2 MB', mb: 4.2, winner: true },
  { name: 'Python 3.12', ram: '14.5 MB', mb: 14.5, winner: false },
  { name: 'Node.js v22', ram: '38.0 MB', mb: 38.0, winner: false },
  { name: 'Java 17 OpenJDK', ram: '85.0 MB', mb: 85.0, winner: false },
];

const loopBenchmarks = [
  { name: 'Java 17 (HotSpot JIT)', time: '0.053s', winner: true, note: 'Decades of JIT optimization' },
  { name: 'Python 3.12 (Bytecode)', time: '0.060s', winner: false, note: 'Standard CPython' },
  { name: 'Shae v0.2 (AST Reference)', time: '0.118s', winner: false, note: 'Pure recursive AST tree-walker' },
  { name: 'Shae v1.0 (VM Target)', time: '~0.035s', winner: false, note: 'Planned Register Bytecode VM' },
];
---

<Layout
  title="Benchmarks & Cold Truth — Shae"
  description="Transparent, unedited performance metrics for Shae v0.2. Cold startup time, memory footprint, and loop execution."
>
  <div class="bench-header">
    <div class="container">
      <span class="badge badge-red">No-BS Telemetry</span>
      <h1>Brutally Honest Benchmarks</h1>
      <p>We are not going to claim our v0.2 tree-walker beats C++. Here is what is actually true.</p>
    </div>
  </div>

  <div class="bench-body">
    <div class="container">
      <!-- Philosophy Banner -->
      <div class="card bench-banner">
        <div class="banner-badge">PHILOSOPHY // REALITY CHECK</div>
        <h2>Where Shae excels right now</h2>
        <p>
          Shae v0.2 prioritizes <strong>instant cold startup</strong> (3ms), <strong>tiny memory footprints</strong> (4.2MB), <strong>concurrency without ceremony</strong>, and <strong>zero dependency friction</strong>. If you are training neural nets or crunching physics simulations, use C or Rust. If you are building microservices, automation scripts, CLIs, and APIs—Shae gets out of your way faster than anything else.
        </p>
      </div>

      <!-- Startup Grid -->
      <section class="bench-section">
        <div class="sec-head">
          <span class="badge badge-red">Startup Latency</span>
          <h2>Cold Process Launch Time</h2>
          <p>Time from terminal command execution to printed output (CLI responsiveness).</p>
        </div>

        <div class="bench-bars-card card">
          {startupBenchmarks.map((b) => (
            <div class="bar-row">
              <div class="bar-info">
                <span class:list={['runtime-name', { 'winner-text': b.winner }]}>
                  {b.name}
                </span>
                <span class="bar-stat">{b.time} ({b.relative})</span>
              </div>
              <div class="bar-track">
                <div
                  class:list={['bar-fill', { 'bar-green': b.winner, 'bar-dim': !b.winner }]}
                  style={`width: ${Math.max(5, (b.ms / 120) * 100)}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Memory Grid -->
      <section class="bench-section">
        <div class="sec-head">
          <span class="badge">RAM Usage</span>
          <h2>Resident Set Size (Base Footprint)</h2>
          <p>Memory consumed by an idle process before user code allocations.</p>
        </div>

        <div class="bench-bars-card card">
          {memoryBenchmarks.map((b) => (
            <div class="bar-row">
              <div class="bar-info">
                <span class:list={['runtime-name', { 'winner-text': b.winner }]}>
                  {b.name}
                </span>
                <span class="bar-stat">{b.ram}</span>
              </div>
              <div class="bar-track">
                <div
                  class:list={['bar-fill', { 'bar-cyan': b.winner, 'bar-dim': !b.winner }]}
                  style={`width: ${Math.max(6, (b.mb / 85) * 100)}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Loop Performance -->
      <section class="bench-section">
        <div class="sec-head">
          <span class="badge">Raw Compute</span>
          <h2>200,000 Iteration Loop Test</h2>
          <p>Iterating 200k arithmetic operations inside a single loop.</p>
        </div>

        <div class="loop-table-card card">
          <table class="bench-table">
            <thead>
              <tr>
                <th>Runtime Engine</th>
                <th>Time (Seconds)</th>
                <th>Context</th>
              </tr>
            </thead>
            <tbody>
              {loopBenchmarks.map((l) => (
                <tr>
                  <td><strong>{l.name}</strong></td>
                  <td><code class="time-tag">{l.time}</code></td>
                  <td class="context-cell">{l.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .bench-header {
    padding: 4rem 0 2rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-dim);
    text-align: center;
  }

  .bench-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--text-main);
    margin: 0.75rem 0 0.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .bench-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .bench-body {
    padding: 3rem 0 6rem;
  }

  .bench-banner {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    margin-bottom: 3.5rem;
    padding: 2.5rem;
    border-radius: var(--card-radius);
    box-shadow: var(--elevated-shadow);
  }

  .banner-badge {
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--accent-primary);
    background: var(--accent-badge-bg);
    border: 1px solid var(--accent-badge-border);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .bench-banner h2 {
    color: var(--text-main);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .bench-banner p {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 0.96rem;
  }

  .bench-section {
    margin-bottom: 3.5rem;
  }

  .sec-head {
    margin-bottom: 1.5rem;
  }

  .sec-head h2 {
    font-size: 1.6rem;
    color: var(--text-main);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.25rem;
  }

  .sec-head p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .bench-bars-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
  }

  .bar-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  .runtime-name {
    font-weight: 600;
    color: var(--text-main);
  }

  .winner-text {
    color: var(--accent-primary);
    font-weight: 700;
  }

  .bar-stat {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .bar-track {
    height: 8px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 9999px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: 9999px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bar-green {
    background: var(--accent-primary);
  }

  .bar-cyan {
    background: var(--text-main);
  }

  .bar-dim {
    background: var(--border-bright);
  }

  .loop-table-card {
    padding: 0;
    overflow: hidden;
    border-radius: var(--card-radius);
  }

  .bench-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .bench-table th {
    background: var(--bg-card-subtle);
    padding: 1rem 1.25rem;
    text-align: left;
    color: var(--text-muted);
    font-weight: 600;
    border-bottom: 1px solid var(--border-dim);
  }

  .bench-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-dim);
    color: var(--text-main);
  }

  .bench-table tr:last-child td {
    border-bottom: none;
  }

  .time-tag {
    font-family: var(--font-mono);
    color: var(--accent-primary);
    background: var(--accent-badge-bg);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .context-cell {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>

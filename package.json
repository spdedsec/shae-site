{
  "name": "shae-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321 --host",
    "start": "astro dev --port 4321 --host",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:ui": "playwright test --ui",
    "lighthouse": "CHROME_PATH=/usr/bin/chromium lhci autorun",
    "analyze": "ANALYZE=true npm run build",
    "format": "prettier --write .",
    "ship-check": "npm run verify:all && npm run build && npm run test",
    "verify:wasm": "node scripts/verify-wasm-contract.mjs",
    "verify:registry": "node scripts/verify-registry-schema.mjs",
    "verify:all": "npm run check && npm run lint && npm run verify:wasm && npm run verify:registry"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@rollup/rollup-linux-x64-gnu": "^4.64.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2"
  }
}
